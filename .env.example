# Documentation only: scripts.local.stack ignores ambient .env files.
# Credentials are generated once under ignored .local/<project>/ with mode 0600.
# Override ports at bootstrap: --port gateway=18080 --port s3=18333
FCB_GATEWAY_PORT=18080
FCB_CONTENT_PORT=18002
FCB_S3_PORT=18333
FCB_NATS_PORT=14222
FCB_REDIS_PORT=16379
FCB_OTLP_GRPC_PORT=14317
FCB_OTLP_HTTP_PORT=14318
FCB_ADMINER_PORT=18081
