# Application identity and runtime
APP_NAME=Flashcards Content Service
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# HTTP exposure
APP_DOCS_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=[]
APP_CORS_ALLOW_CREDENTIALS=false
APP_REQUEST_BODY_MAX_BYTES=1048576

# Optional PostgreSQL persistence; inject a generated URL only when enabling it.
APP_DATABASE_ENABLED=false
# APP_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=5
APP_DATABASE_POOL_TIMEOUT_SECONDS=5
APP_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Optional OTLP gRPC export; local collector availability is not a readiness dependency.
APP_TELEMETRY_ENABLED=false
APP_METRICS_ENABLED=false
APP_TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4317
APP_TELEMETRY_EXPORT_TIMEOUT_SECONDS=5
