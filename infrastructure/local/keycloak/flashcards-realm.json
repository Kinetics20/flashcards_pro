{
  "realm": "flashcards",
  "enabled": true,
  "displayName": "Flashcards local development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "flashcards-dev",
      "name": "Local integration fixture (not API authorization)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${FCB_OIDC_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "flashcards-dev-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "flashcards-dev",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
